# 智聘通 - 环境变量配置

# 服务端口
PORT=3000

# CodeBuddy API Key (从 https://www.codebuddy.cn 获取)
# 方式一：使用 API Key
CODEBUDDY_API_KEY=your_api_key_here

# 方式二：使用 Auth Token
# CODEBUDDY_AUTH_TOKEN=your_auth_token_here

# 网络环境 (external 表示外网环境)
CODEBUDDY_INTERNET_ENVIRONMENT=external

# API Base URL (可选，使用默认值即可)
# CODEBUDDY_BASE_URL=https://api.example.com
